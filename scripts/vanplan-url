#!/usr/bin/env python3
"""vanplan URL codec — same as the Rust hash: gzip(yaml) → base64url → vp1.

Hash format: #vp1.<base64url(gzip(yaml), no padding)>

gzip is RFC 1952 (compresslevel=9, mtime=0). base64url is url-safe without padding.

Interop vector (empty document YAML). Rust decode must accept this hash:
    vanplan: 1
    nodes: []
    edges: []
  HASH: vp1.H4sIAAAAAAAC_ytLzCvIScyzUjDkystPSS22UoiO5UpNSYeyABFfqaYfAAAA
"""
from __future__ import annotations

import base64
import gzip
import sys

ORIGIN = "http://127.0.0.1:8080"
PREFIX = "vp1."


def encode_yaml(yaml: str) -> str:
    raw = yaml.encode("utf-8")
    compressed = gzip.compress(raw, compresslevel=9, mtime=0)
    token = base64.urlsafe_b64encode(compressed).rstrip(b"=").decode("ascii")
    return PREFIX + token


def decode_payload(s: str) -> str:
    s = s.strip()
    if "#vp1." in s:
        s = s[s.rfind("#vp1.") + 1 :]
    elif s.startswith("#"):
        s = s[1:]
    if not s.startswith(PREFIX):
        raise SystemExit("not a vp1 hash")
    payload = s[len(PREFIX) :]
    if not payload:
        raise SystemExit("empty vp1 payload")
    pad = "=" * ((4 - len(payload) % 4) % 4)
    compressed = base64.urlsafe_b64decode(payload.encode("ascii") + pad.encode("ascii"))
    return gzip.decompress(compressed).decode("utf-8")


def usage() -> None:
    sys.stderr.write(
        "usage: vanplan-url encode [file|-]\n"
        "       vanplan-url decode [hash-or-url|-]\n"
    )
    raise SystemExit(2)


def read_arg(arg: str) -> str:
    if arg == "-":
        return sys.stdin.read()
    with open(arg, encoding="utf-8") as f:
        return f.read()


def main(argv: list[str]) -> None:
    if len(argv) < 1:
        usage()
    cmd = argv[0]
    arg = argv[1] if len(argv) > 1 else "-"
    if cmd == "encode":
        yaml = read_arg(arg)
        sys.stdout.write(f"{ORIGIN}/#{encode_yaml(yaml)}\n")
    elif cmd == "decode":
        raw = sys.stdin.read() if arg == "-" else arg
        yaml = decode_payload(raw)
        sys.stdout.write(yaml)
    else:
        usage()


if __name__ == "__main__":
    main(sys.argv[1:])
